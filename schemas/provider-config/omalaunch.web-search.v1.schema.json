{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omalaunch Web Search configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "engines"],
  "properties": {
    "version": { "const": 1 },
    "rankByUsage": { "type": "boolean", "default": true },
    "engines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "url": { "type": "string", "minLength": 10, "maxLength": 2048 }
        }
      }
    }
  }
}
