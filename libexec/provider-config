#!/usr/bin/env python3
from __future__ import annotations
import json, os, secrets, shutil, sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).parent))
import provider_config as pc
ROOT=Path(__file__).resolve().parents[1]
AGENT_LAUNCHER=ROOT/"libexec/omalaunch-launch-agent"

def fail(e:object)->None:
    print("provider-config: "+str(e),file=sys.stderr); raise SystemExit(1)
def main(a:list[str])->None:
    home=Path(os.environ.get("HOME",str(Path.home())))
    if not a: fail("missing command")
    if a[0]=="read-all":
        values={}; diagnostics=[]
        for provider in pc.PROVIDERS:
            try: state=pc.load_state(provider,home)
            except (OSError,UnicodeError,ValueError,json.JSONDecodeError) as e:
                state=pc.state_default(provider); diagnostics.append(f"Could not load state for {provider}: {e}"[:512])
            config={}
            if provider in pc.CONFIG_PROVIDERS:
                try: config=pc.load_config(provider,home)
                except (OSError,UnicodeError,ValueError,json.JSONDecodeError) as e:
                    config=pc.config_default(provider); diagnostics.append(f"Could not load configuration for {provider}: {e}"[:512])
            values[provider]={**state,**config}
        print(json.dumps({"configs":values,"diagnostics":diagnostics[:64]},ensure_ascii=False)); return
    if len(a)<2: fail("missing provider")
    command,provider=a[:2]
    metadata=pc.CONFIG_METADATA.get(provider)
    if command=="configuration-menu" and len(a)==3:
        requested_by=a[2]
        if metadata is None: fail("provider has no configuration menu")
        if requested_by!=provider: fail("configuration provider identity does not match the active extension")
        executable=str(Path(__file__).resolve())
        def action(ident,label,icon,tools):
            if all(shutil.which(name) for name in tools):
                return {"id":ident,"label":label,"icon":icon,"command":[executable,ident,provider],"closeOnDispatch":True}
            detail="Unavailable: install "+" and ".join(name for name in tools if not shutil.which(name))
            return {"id":ident,"label":label+" (unavailable)","description":detail,"icon":icon,
                    "command":[executable,"unavailable-action",detail]}
        print(json.dumps({"items":[
            action("open-config","Open config file","󰈙",("omarchy-launch-editor",)),
            action("edit-config-agent","Edit with agent","󰚩",("omarchy-default-agent","omarchy-agent")),
        ]},ensure_ascii=False)); return
    if command=="unavailable-action" and len(a)==2: fail(provider)
    if command in ("open-config","edit-config-agent") and len(a)==2:
        if metadata is None: fail("provider has no configuration menu")
        path=pc.ensure_config(provider,home)
        if command=="open-config": os.execvp("omarchy-launch-editor",["omarchy-launch-editor",str(path)])
        label=metadata["label"]
        schema=ROOT/"schemas/provider-config"/(provider+f'.v{metadata["schemaVersion"]}.schema.json')
        prompt=(f"Help the user edit the Omalaunch {label} configuration at {path}. "
                f"Review the configuration schema at {schema} now, summarize the settings the user can change, "
                "and then ask what they want to change. Do not change the configuration until the user provides "
                "direction. Preserve JSONC syntax and change only the requested settings.")
        os.execv(str(AGENT_LAUNCHER),[str(AGENT_LAUNCHER),"--dir",str(path.parent),"--prompt",prompt])
    if command=="read": print(json.dumps(pc.load(provider,home),ensure_ascii=False)); return
    def toggle(data,key):
        values=data["favorites"]
        if key in values: values.remove(key)
        elif len(values)<pc.MAX_ITEMS: values.append(key)
        else: fail("favorites are full")
    if command=="toggle" and len(a)==3:
        value=a[2]
        if provider=="omalaunch.files":
            kind,path=value.split(":",1); path=pc.normalize_path(path,home); key={"type":kind,"path":path}
            pc.mutate(provider,home,lambda d: d["favorites"].remove(key) if key in d["favorites"] else d["favorites"].append(key))
        else: pc.mutate(provider,home,lambda d: toggle(d,value))
        return
    if provider=="omalaunch.web-search" and command in ("toggle-global-search","toggle-star") and len(a)==3:
        ident=a[2]
        config=pc.load_config(provider,home)
        if ident not in {engine["id"] for engine in config["engines"]}: fail("unknown search engine id")
        def toggle_engine(data):
            if command=="toggle-star":
                values=data["starredEngines"]
                if ident in values: values.remove(ident)
                else:
                    values.append(ident)
                    if ident in data["globalSearchExcludedEngines"]: data["globalSearchExcludedEngines"].remove(ident)
            else:
                values=data["globalSearchExcludedEngines"]
                if ident in values: values.remove(ident)
                else:
                    values.append(ident)
                    if ident in data["starredEngines"]: data["starredEngines"].remove(ident)
        pc.mutate(provider,home,toggle_engine); return
    if provider=="omalaunch.quicklinks":
        def update(data,ident,fn):
            link=next((x for x in data["links"] if x["id"]==ident),None)
            if link is None: fail("unknown link id")
            fn(link)
        if command=="add" and len(a)==4:
            pc.mutate(provider,home,lambda d: d["links"].append({"id":secrets.token_hex(16),"name":a[3],"url":a[2],"starred":False,"openWith":{"type":"default"}})); return
        if command in ("set-name","set-url") and len(a)==4:
            field="name" if command=="set-name" else "url"
            pc.mutate(provider,home,lambda d:update(d,a[2],lambda x:x.update({field:a[3]}))); return
        if command=="star" and len(a)==4 and a[3] in ("true","false"):
            pc.mutate(provider,home,lambda d:update(d,a[2],lambda x:x.update(starred=a[3]=="true"))); return
        if command=="delete" and len(a)==3:
            pc.mutate(provider,home,lambda d:update(d,a[2],lambda _:d.update(links=[x for x in d["links"] if x["id"]!=a[2]]))); return
    fail("invalid command")
try: main(sys.argv[1:])
except (OSError,UnicodeError,ValueError,json.JSONDecodeError,KeyError) as e: fail(e)
