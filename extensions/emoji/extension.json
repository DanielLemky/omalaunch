{
  "schemaVersion": 1,
  "id": "omalaunch.emoji",
  "capability": "emoji",
  "mode": "emoji",
  "label": "Emoji",
  "prefixes": ["emoji"],
  "icon": "",
  "description": "Press Enter to paste",
  "rootDescription": "Search and paste emoji",
  "priority": 10,
  "requires": ["omarchy-menu-emoji-insert", "wtype", "wl-copy"],
  "data": [
    "{omarchyPath}/shell/plugins/emojis/emojis.json",
    "{extensionDir}/emojis.json"
  ],
  "groups": "{extensionDir}/groups.json",
  "command": ["omarchy-menu-emoji-insert", "{emoji}"],
  "copyCommand": ["wl-copy", "--", "{emoji}"]
}
