{
  "schemaVersion": 1,
  "id": "omalaunch.add-extension",
  "capability": "add-extension",
  "mode": "workflow",
  "label": "Add Extension",
  "prefixes": ["add extension"],
  "icon": "󰐕",
  "description": "Add an Omalaunch extension",
  "requires": ["omarchy", "python", "omarchy-agent", "omarchy-default-agent", "xdg-open"],
  "workflow": {
    "items": [
      {
        "id": "browse-marketplace",
        "kind": "action",
        "label": "Open Marketplace in Browser",
        "closeOnDispatch": true,
        "command": [
          "xdg-open",
          "https://daniellemky.github.io/omalaunch-extensions/"
        ]
      },
      {
        "id": "add-from-git",
        "kind": "input",
        "label": "Add from Git Repository",
        "prompt": "Git repository URL",
        "maxLength": 2048,
        "refreshExtensions": true,
        "command": [
          "omarchy",
          "plugin",
          "add",
          "{input}",
          "--enable"
        ]
      },
      {
        "id": "create-with-agent",
        "kind": "input",
        "label": "Create with Agent",
        "prompt": "Extension name",
        "maxLength": 120,
        "closeOnDispatch": true,
        "command": [
          "python",
          "{extensionDir}/create-with-agent.py",
          "{input}"
        ]
      }
    ]
  }
}
